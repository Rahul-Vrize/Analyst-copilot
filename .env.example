# Choose ONE provider.

# Option A: direct Anthropic API
ANTHROPIC_API_KEY=
ANALYST_COPILOT_LLM_MODEL=claude-sonnet-5

# Option B: AWS Bedrock (set LLM_PROVIDER=bedrock to use this instead)
LLM_PROVIDER=anthropic
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL=

# Optional overrides
ANALYST_COPILOT_DATA_DIR=./data
