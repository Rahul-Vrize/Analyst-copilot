# The Analyst Copilot — environment
# Copy to .env and fill in.   cp .env.example .env
# .env is gitignored. NEVER commit real keys.

# ═════════════════════════════════════════════════════════════════════════════
# DATABASE  (D7)
# ═════════════════════════════════════════════════════════════════════════════
# Local (docker-compose up -d) — this is the path a GRADER uses.
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/analyst_copilot

# Azure Postgres Flexible Server — our live-demo / shared-team instance.
# Swap the line above for this one. The schema is identical; no Azure-only feature is used.
# DATABASE_URL=postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/analyst_copilot?sslmode=require
#
# Before CREATE EXTENSION works on Azure, allowlist these in the server parameter
# `azure.extensions` (Portal → Server parameters):   vector, pg_trgm, unaccent


# ═════════════════════════════════════════════════════════════════════════════
# AZURE AI FOUNDRY — all model calls (D9, D15)
# ═════════════════════════════════════════════════════════════════════════════

# ── Verifier B — SECOND FAMILY.  ⚠️ Claude/Haiku is NOT available on our Foundry.
#    See config.yaml `verification.independence` and HANDOFF §8e before changing this.
#    Preferred: any non-OpenAI family present in the catalog (Cohere Command,
#    Mistral, DeepSeek, Llama). Fall back to a DIFFERENT OpenAI model, never the same one.
# CURRENT: quota exists for gpt-5-mini only, so B is the same model as the
# extractor and independence comes from adversarial framing (config.yaml).
VERIFIER_B_PROVIDER=azure_openai         # azure_openai | anthropic_foundry | cohere_foundry
VERIFIER_B_DEPLOYMENT=gpt-5-mini
#
# LATER, once a Claude deployment exists — swap to a genuine second family by
# changing these three lines and setting verification.independence: different_family
# in config.yaml. No code change required (IMPLEMENTATION_PLAN §22.7).
# VERIFIER_B_PROVIDER=anthropic_foundry
# VERIFIER_B_DEPLOYMENT=claude-haiku-4-5
# AZURE_FOUNDRY_API_KEY=
# AZURE_FOUNDRY_RESOURCE=

# ── GPT-5.4-mini (routing, planning, extraction, formula selection, verifier A)
#    openai SDK, AzureOpenAI(azure_endpoint=, api_key=, api_version=)
AZURE_OPENAI_ENDPOINT=                  # https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
GPT_DEPLOYMENT=gpt-5-mini               # ⚠️ confirm its context window — the assembly must fit

# ── Embeddings
# ⚠️ EMBEDDING_DIMENSIONS MUST EQUAL pages.embedding vector(N) in
# migrations/001_init.sql AND models.embeddings.dimensions in config.yaml.
# A mismatch fails EVERY page insert — and it fails at the END of a long
# ingest, so config.py asserts all three agree at startup.
EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024               # the deployment returns 1024 here; well under
                                        # pgvector's hnsw 2000-dim cap.

# ── Reranker — Cohere-rerank-v4.0-pro serverless endpoint on Foundry
COHERE_RERANK_ENDPOINT=
COHERE_RERANK_API_KEY=


# ═════════════════════════════════════════════════════════════════════════════
# PATHS
# ═════════════════════════════════════════════════════════════════════════════
ANALYST_COPILOT_DATA_DIR=./data
FILINGS_DIR=../tac/analyst-copilot-data/filings
PRACTICE_QUESTIONS=../tac/analyst-copilot-data/practice-questions.jsonl

# Everything else (top-k values, thresholds, model→stage bindings) lives in
# config.yaml, not here. Secrets and connection strings only in this file.

# ═════════════════════════════════════════════════════════════════════════════
# AWS BEDROCK — the second model family (D4)
# ═════════════════════════════════════════════════════════════════════════════
# ⚠️ WHY BEDROCK AND NOT FOUNDRY. Claude on Microsoft Foundry bills through
# Azure Marketplace, which a free-trial or credit-only Azure subscription cannot
# purchase (and adding a card charges the card INSTEAD of the Azure credit).
# Bedrock bills Claude as ordinary AWS usage against the account's credits, so
# it is the one route to a genuine second family at the generate→verify seam.
#
# SETUP, in order:
#   1. Bedrock console → Model access → enable the Anthropic models you want.
#      This is per-model and per-region. Skipping it gives AccessDenied, which
#      reads like a credentials problem and is not.
#   2. Create an IAM user with ONLY `bedrock:InvokeModel` (see below) and use
#      its keys here. Do NOT put root credentials in this file.
#   3. Point verifier_b at it:
#        VERIFIER_B_PROVIDER=bedrock
#        VERIFIER_B_DEPLOYMENT=anthropic.claude-haiku-4-5
#      and set `verifier_b_adversarial: false` in config.yaml — refutation
#      framing is a SUBSTITUTE for independence, not an addition to it.
#
# ⚠️ Bedrock model ids carry an `anthropic.` PREFIX that no other route uses.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # only for temporary/STS credentials
# AWS_PROFILE=                # alternative to keys: a named profile on disk
#
# Leave the keys blank to use the standard credential chain (shared profile,
# instance role) — that is how a grader runs this on their own AWS account.
