__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
# Any .env variant - .env.bak held real API keys and the DB password and was
# NOT covered by the bare `.env` rule.
.env.*
!.env.example

# Local scratch: page-split pickles, ingest logs, eval runs. Rebuildable.
.cache/

# Local databases and derived/cached artifacts (rebuildable from data/filings)
data/raw/*
data/cache/*
!data/raw/.gitkeep
!data/cache/.gitkeep
*.db
*.duckdb

# Raw filings and practice set are large / provided separately, not committed
data/filings/*
data/practice/*
!data/filings/.gitkeep
!data/practice/.gitkeep

.streamlit/secrets.toml
.pytest_cache/
.DS_Store
